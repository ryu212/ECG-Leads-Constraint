# Keep only Python source from v13 among versioned implementations.
/v[0-9]*/
!/v13/
/v13/**
!/v13/**/
!/v13/**/*.py

# Feedback and paper directories: Python source only.
/feedback/**
!/feedback/**/
!/feedback/**/*.py
/feedbacked/**
!/feedbacked/**/
!/feedbacked/**/*.py
/paper_v2/**
!/paper_v2/**/
!/paper_v2/**/*.py

# External implementations: source, dependency manifests and attribution.
/external/**
!/external/**/
!/external/**/*.py
!/external/**/*.sh
!/external/**/*.ps1
!/external/**/requirements*.txt
!/external/**/pyproject.toml
!/external/**/setup.cfg
!/external/**/environment.yml
!/external/**/environment.yaml
!/external/**/README.md
!/external/**/LICENSE*
!/external/**/NOTICE*

# Data, checkpoints and generated artifacts (including inside source trees).
data/
datasets/
code_test/
checkpoint/
checkpoints/
artifact/
artifacts/
metrics/
results/
outputs/
dnn_predicts/
*.pt
*.pth
*.ckpt
*.h5
*.hdf5
*.keras
*.onnx
*.npy
*.npz
*.pkl
*.pickle
*.tfrecord
*.tfrecords
*.[pP][dD][fF]
*.[cC][sS][vV]
*.xlsx
*.xls

# Private notes and idea documents.
[tT][hH][eE][oO][rR][iI][sS][mM].[mM][dD]
[uU][sS][aA][gG][eE].[mM][dD]
*[iI][dD][eE][aA]*.[mM][dD]

# Python caches, environments and local editor state.
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.venv/
venv/
env/
.env
